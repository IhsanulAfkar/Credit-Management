// Prisma schema for Credit Management application

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BorrowerStatus {
  AKTIF
  TIDAK_AKTIF
}

enum LoanStatus {
  DRAFT
  AKTIF
  LUNAS
  DIBATALKAN
}

enum InstallmentStatus {
  BELUM_JATUH_TEMPO
  JATUH_TEMPO
  TERLAMBAT
  LUNAS
}

enum InstallmentPeriod {
  BULANAN
  MINGGUAN
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  role          String        @default("admin")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  chatHistories ChatHistory[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Borrower {
  id                        String                     @id @default(cuid())
  name                      String
  phone                     String
  identityNumber            String?
  address                   String?
  occupation                String?
  businessName              String?
  notes                     String?
  status                    BorrowerStatus             @default(AKTIF)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  loans                     Loan[]
  chatExecutionHistoryItems ChatExecutionHistoryItem[]
}

model LoanTerm {
  id                        String                     @id @default(cuid())
  name                      String
  months                    Int // Number of installments (periods) for loans using this term
  period                    InstallmentPeriod          @default(BULANAN)
  interestRate              Float
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  loans                     Loan[]
  chatExecutionHistoryItems ChatExecutionHistoryItem[]
}

model Loan {
  id                        String                     @id @default(cuid())
  loanNumber                String                     @unique
  borrowerId                String
  borrower                  Borrower                   @relation(fields: [borrowerId], references: [id])
  principalAmount           Int
  interestRate              Float
  interestAmount            Int
  totalAmount               Int
  monthlyInstallment        Int // Per-period installment amount
  termMonths                Int // Number of installments (periods)
  period                    InstallmentPeriod          @default(BULANAN)
  disbursementDate          DateTime
  firstDueDate              DateTime
  purpose                   String?
  notes                     String?
  status                    LoanStatus                 @default(AKTIF)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  installments              Installment[]
  loanTerm                  LoanTerm?                  @relation(fields: [loanTermId], references: [id])
  loanTermId                String?
  chatExecutionHistoryItems ChatExecutionHistoryItem[]
}

model Installment {
  id                        String                     @id @default(cuid())
  loanId                    String
  loan                      Loan                       @relation(fields: [loanId], references: [id])
  installmentNumber         Int
  dueDate                   DateTime
  amount                    Int
  paidAmount                Int                        @default(0)
  paidAt                    DateTime?
  status                    InstallmentStatus          @default(BELUM_JATUH_TEMPO)
  notes                     String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  payments                  Payment[]
  chatExecutionHistoryItems ChatExecutionHistoryItem[]
}

model Payment {
  id                        String                     @id @default(cuid())
  installmentId             String
  installment               Installment                @relation(fields: [installmentId], references: [id])
  amount                    Int
  paidAt                    DateTime
  notes                     String?
  receipt                   String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  chatExecutionHistoryItems ChatExecutionHistoryItem[]
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ChatHistory {
  id                     String                 @id @default(cuid())
  user_id                String
  role                   String
  content                String
  reasoning              String?
  user                   User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at             DateTime               @default(now())
  chatExecutionHistories ChatExecutionHistory[]
}

model ChatExecutionHistory {
  id                        String                     @id @default(cuid())
  chat_id                   String
  method                    String
  payload                   Json?
  chat                      ChatHistory                @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  created_at                DateTime                   @default(now())
  chatExecutionHistoryItems ChatExecutionHistoryItem[]
}

model ChatExecutionHistoryItem {
  id String @id @default(cuid())

  chatExecutionHistoryId String?
  chatExecutionHistory   ChatExecutionHistory? @relation(fields: [chatExecutionHistoryId], references: [id], onDelete: Cascade)

  borrowerId String?
  borrower   Borrower? @relation(fields: [borrowerId], references: [id], onDelete: SetNull)

  loanId String?
  loan   Loan?   @relation(fields: [loanId], references: [id], onDelete: SetNull)

  loanTermId String?
  loanTerm   LoanTerm? @relation(fields: [loanTermId], references: [id], onDelete: SetNull)

  installmentId String?
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}
